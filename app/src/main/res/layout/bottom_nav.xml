<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Floating wrapper: margins on all sides create the "floating" look,
         instead of the bar being flush with the screen edge -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:elevation="12dp"
        android:outlineProvider="background"
        android:background="@drawable/bg_glass_pill"
        android:clipToOutline="true"
        app:blurOverlayColor="#33FFFFFF">

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:color/transparent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Left group: EQ + MBC -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="18dp">
                    <ImageButton
                        android:id="@+id/navPresetsButton"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_equalizer"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="EQ"
                        android:scaleType="centerInside"
                        app:tint="?attr/colorOnSurface" />
                    <TextView
                        android:id="@+id/navEqStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ON"
                        android:textSize="8sp"
                        android:textColor="#FF888888" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/navMbcButton"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_compress"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Multiband Compression"
                        android:scaleType="centerInside"
                        app:tint="?attr/colorOnSurface" />
                    <TextView
                        android:id="@+id/navMbcStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textSize="8sp"
                        android:textColor="#FF888888" />
                </LinearLayout>
            </LinearLayout>

            <!-- Center: Power button, raised slightly above the pill -->
            <ImageButton
                android:id="@+id/powerFab"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_nav_power"
                android:scaleType="centerInside"
                android:background="@drawable/bg_power_button_ripple"
                android:contentDescription="Power"
                android:focusable="true" />

            <!-- Right group: Limiter + Settings -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="18dp">
                    <ImageButton
                        android:id="@+id/navLimiterButton"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_limiter"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Limiter"
                        android:scaleType="centerInside"
                        app:tint="?attr/colorOnSurface" />
                    <TextView
                        android:id="@+id/navLimiterStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ON"
                        android:textSize="8sp"
                        android:textColor="#FF888888" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="20dp">
                    <ImageButton
                        android:id="@+id/navMusicButton"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_equalizer"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Music"
                        android:scaleType="centerInside"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageButton
                        android:id="@+id/navSettingsButton"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_settings"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Settings"
                        android:scaleType="centerInside"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</merge>
